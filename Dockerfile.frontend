# ==============================================================================
# SignalScript Frontend Dockerfile (Vite Build + Nginx Alpine on Port 7100)
# ==============================================================================

# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package descriptors for layer caching
COPY frontend/package*.json ./
RUN npm install

# Copy frontend source tree
COPY frontend/ ./

# Build optimized static distribution
RUN npm run build

# Production Stage with Nginx
FROM nginx:alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built distribution from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx server configuration (listening on 7100)
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Standard SignalScript frontend port
EXPOSE 7100

# Healthcheck testing HTTP response on port 7100
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:7100/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
