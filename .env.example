# ==========================================
# SignalScript Terminal Environment Template
# ==========================================

# Binance Futures API (Optional, public endpoints work without keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenRouter AI Copilot (Optional, consultative second opinion works with honest fallback if empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Order Flow & Storage Configuration
MAX_STORAGE_GB=100.0
FOCUS_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT
WATCHLIST_SYMBOLS=BNBUSDT,SUIUSDT,NEARUSDT

# Application Ports & Host
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db
LOG_LEVEL=INFO
